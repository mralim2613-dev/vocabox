{
  "name": "vocabox",
  "version": "1.0.0",
  "description": "Vocabox — Fasiləli təkrar və Leitner sistemi ilə ağıllı xarici dil lüğəti",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-catalog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-catalog.mjs",
    "build": "vite build",
    "postbuild": "node scripts/build-offline.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "assets": "node scripts/generate-brand-assets.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:cloud": "node scripts/verify-cloud-release.mjs",
    "release:prepare": "npm test && npm run build && npm run assets && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@supabase/supabase-js": "^2.49.1",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "^0.5.13",
    "vite": "^6.2.0",
    "sharp": "0.34.5",
    "eas-cli": "27.2.0"
  }
}
